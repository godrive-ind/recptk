# Supabase browser client. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# PostgreSQL connection strings for Prisma.
# URL-encode special characters in the password. Example: @ becomes %40.
# Prefer Supabase pooler URLs if your network or host cannot reach the IPv6-only direct DB hostname.
DATABASE_URL="postgresql://postgres.your-project-ref:your-encoded-password@aws-1-your-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-encoded-password@aws-1-your-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Next.js runtime.
APP_URL="http://localhost:3000"
