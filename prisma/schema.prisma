generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  RECRUITER
  VIEWER
}

enum MasterDataType {
  DEPARTMENT
  RECRUITER
  PIC
  REASON
  SOURCE
}

enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole  @default(RECRUITER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sessions          Session[]
  loginHistory      LoginHistory[]
  recruitmentReqs   Ptk[]          @relation("RecruiterRequests")
  activityLogs      ActivityLog[]
  apiLogs           ApiLog[]
  errorLogs         ErrorLog[]
  notifications     Notification[]
  uploadedFiles     FileUpload[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  username  String
  success   Boolean
  reason    String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, createdAt])
  @@index([success, createdAt])
  @@map("login_history")
}

model Ptk {
  id                String    @id @default(cuid())
  noPtk             String    @unique @map("no_ptk")
  posisi            String
  jabatan           String
  departemen        String
  kontrak           String
  alasan            String
  pic               String
  sdmDigantikan     String?   @map("sdm_digantikan")
  nikDigantikan     String?   @map("nik_digantikan")
  tglKeluarMutasi   DateTime? @map("tgl_keluar_mutasi")
  keteranganAlasan  String?   @map("keterangan_alasan")
  recruiter         String
  recruiterUserId   String?   @map("recruiter_user_id")
  gajiDitawarkan    Decimal?  @db.Decimal(14, 2) @map("gaji_ditawarkan")
  tglPtkMasuk       DateTime  @map("tgl_ptk_masuk")
  tglAccPtk         DateTime? @map("tgl_acc_ptk")
  totalPermintaan   Int       @default(1) @map("total_permintaan")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  recruiterUser User?       @relation("RecruiterRequests", fields: [recruiterUserId], references: [id], onDelete: SetNull)
  candidates    Candidate[]

  @@index([departemen, tglPtkMasuk])
  @@index([recruiter, tglPtkMasuk])
  @@index([tglAccPtk])
  @@index([deletedAt])
  @@map("ptks")
}

model Candidate {
  id                String    @id @default(cuid())
  ptkId             String    @map("ptk_id")
  namaKandidat      String    @map("nama_kandidat")
  noWaKandidat      String?   @map("no_wa_kandidat")
  melamarMelalui    String    @map("melamar_melalui")
  tglJoinTolak      DateTime? @map("tgl_join_tolak")
  prosesRekrutmen   String    @map("proses_rekrutmen")
  tglPsikotes       DateTime? @map("tgl_psikotes")
  tglItwHr          DateTime? @map("tgl_itw_hr")
  tglItwUser        DateTime? @map("tgl_itw_user")
  hasilRekrutmen    String    @default("In Progress") @map("hasil_rekrutmen")
  gajiDisepakati    Decimal?  @db.Decimal(14, 2) @map("gaji_disepakati")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  ptk Ptk @relation(fields: [ptkId], references: [id], onDelete: Cascade)

  @@index([ptkId, hasilRekrutmen])
  @@index([namaKandidat])
  @@index([noWaKandidat])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("candidates")
}

model MasterData {
  id        String           @id @default(cuid())
  type      MasterDataType
  name      String
  status    MasterDataStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  @@unique([type, name])
  @@index([type, status])
  @@index([deletedAt])
  @@map("master_data")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model ApiLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  durationMs Int      @map("duration_ms")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@map("api_logs")
}

model ErrorLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  source      String
  message     String
  stack       String?
  context     Json?
  severity    String   @default("error")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@index([severity, createdAt])
  @@map("error_logs")
}

model Notification {
  id        String             @id @default(cuid())
  userId    String?            @map("user_id")
  title     String
  body      String
  status    NotificationStatus @default(UNREAD)
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  readAt    DateTime?          @map("read_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model FileUpload {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  filename      String
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  storageKey    String?  @map("storage_key")
  checksum      String?
  status        String   @default("uploaded")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("file_uploads")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  anonymousId String?  @map("anonymous_id")
  userId      String?  @map("user_id")
  event       String
  properties  Json?
  path        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
